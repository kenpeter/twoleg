<?xml version='1.0' encoding='utf-8'?>
<mujoco model="ankle_assembly_left">
  <!-- Manual p.11 "左腿" ankle = foot_assembly_left + little_u_assembly_left:
       大脚板 + 多功能支架 + 舵机 + 金属舵盘 with the two perpendicular 短U brackets on top.
       The little_u is shifted so the lower 短U big hole is concentric with the servo shaft /
       horn centre hole (Y = 0.010, Z = 0.01275), so a screw locks them together. -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom type="mesh" group="3"/></default>
  </default>
  <asset>
    <mesh name="foot" file="大脚板/脚板支架.STL" scale="0.001 0.001 0.001"/>
    <mesh name="multi" file="多功能/多功能支架.STL" scale="0.001 0.001 0.001"/>
    <mesh name="shortU" file="短U/短U支架.STL" scale="0.001 0.001 0.001"/>
    <mesh name="servo" file="舵机/舵机.STL" scale="0.001 0.001 0.001"/>
    <mesh name="horn" file="金属舵盘/金属舵盘.STL" scale="0.001 0.001 0.001"/>
    <material name="bracket" rgba="0.75 0.75 0.78 1"/>
    <material name="dark" rgba="0.18 0.18 0.20 1"/>
    <material name="horn" rgba="0.80 0.80 0.82 1"/>
  </asset>
  <worldbody>
    <body name="foot" pos="0 0 0">
      <geom name="foot_visual" mesh="foot" class="visual" material="bracket" pos="-0.06175 -0.03175 -0.001"/>
      <geom name="foot_collision" mesh="foot" class="collision" pos="-0.06175 -0.03175 -0.001" density="2700"/>

      <body name="multi" pos="0.022 0 0.0135" quat="0.70710678 0 0 0.70710678">
        <geom name="multi_visual" mesh="multi" class="visual" material="bracket" pos="-0.029 -0.0185 -0.0125"/>
        <geom name="multi_collision" mesh="multi" class="collision" pos="-0.029 -0.0185 -0.0125" density="2700"/>
      </body>

      <body name="ankle_servo" pos="0.017 0 0.01275" quat="0 -0.7071068 0 0.7071068">
        <geom name="servo_visual" mesh="servo" class="visual" material="dark" pos="-0.009752 -0.027 -0.0215"/>
        <geom name="servo_collision" mesh="servo" class="collision" pos="-0.009752 -0.027 -0.0215" density="1600"/>
      </body>

      <body name="horn" pos="-0.007 0.010 0.01275" quat="0.5 0.5 0.5 -0.5">
        <geom name="horn_visual" mesh="horn" class="visual" material="horn" pos="-0.010 -0.0026 -0.010"/>
      </body>

      <!-- little_u_assembly_left, rotated 90 deg about Z and shifted so its lower big hole
           lines up with the servo shaft / horn centre. -->
      <body name="shortU_up" pos="0.0175 0.010 0.065" quat="0.5 0.5 0.5 0.5">
        <geom name="shortU_up_visual" mesh="shortU" class="visual" material="bracket" pos="-0.027 -0.02225 -0.0125"/>
        <geom name="shortU_up_collision" mesh="shortU" class="collision" pos="-0.027 -0.02225 -0.0125" density="2700"/>
      </body>

      <body name="shortU_down" pos="0.0175 0.010 0.0225" quat="0 0 -0.7071068 0.7071068">
        <geom name="shortU_down_visual" mesh="shortU" class="visual" material="bracket" pos="-0.027 -0.02225 -0.0125"/>
        <geom name="shortU_down_collision" mesh="shortU" class="collision" pos="-0.027 -0.02225 -0.0125" density="2700"/>
      </body>

      <geom name="screw_1" type="cylinder" size="0.0016 0.004" pos="0.0175 0.017 0.04275" quat="0.5 0.5 0.5 0.5" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="screw_2" type="cylinder" size="0.0016 0.004" pos="0.0175 0.003 0.04275" quat="0.5 0.5 0.5 0.5" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="screw_3" type="cylinder" size="0.0016 0.004" pos="0.0105 0.010 0.04275" quat="0.5 0.5 0.5 0.5" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="screw_4" type="cylinder" size="0.0016 0.004" pos="0.0245 0.010 0.04275" quat="0.5 0.5 0.5 0.5" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_1" type="cylinder" size="0.003 0.0012" pos="0.0175 0.017 0.04795" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_2" type="cylinder" size="0.003 0.0012" pos="0.0175 0.003 0.04795" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_3" type="cylinder" size="0.003 0.0012" pos="0.0105 0.010 0.04795" material="dark" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_4" type="cylinder" size="0.003 0.0012" pos="0.0245 0.010 0.04795" material="dark" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
