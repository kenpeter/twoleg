<?xml version='1.0' encoding='utf-8'?>
<mujoco model="right_tricep">
  <!-- Right tricep: sagittal mirror (Y -> -Y) of left_tricep.xml.  The parts are
       chiral, so the meshes are mirrored with a negative Y scale; body/geom Y
       positions are negated and each rotation is conjugated by the mirror,
       q=(w,x,y,z) -> (w,-x,y,-z).  Left/right therefore share the same STL files.
       配件：多功能支架 1 个、舵机 1 个、金属舵盘 1 个、长U 支架 1 个. -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom type="mesh" group="3"/></default>
  </default>
  <asset>
    <mesh name="multi" file="多功能/多功能支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="servo" file="舵机/舵机.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="horn" file="金属舵盘/金属舵盘.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="longU" file="长U/长U支架.STL" scale="0.001 -0.001 0.001"/>
    <material name="bracket" rgba="0.75 0.75 0.78 1"/>
    <material name="dark" rgba="0.18 0.18 0.20 1"/>
    <material name="horn" rgba="0.80 0.80 0.82 1"/>
  </asset>
  <worldbody>
    <body name="multi_0" pos="0.013500 -0.022000 0.000000" quat="0.000000 -0.707107 0.000000 -0.707107">
      <geom name="multi_0_v" mesh="multi" class="visual" material="bracket" pos="-0.029 0.0185 -0.0125"/>
      <geom name="multi_0_c" mesh="multi" class="collision" pos="-0.029 0.0185 -0.0125" density="2700"/>
    </body>
    <body name="servo_1" pos="0.012750 -0.017000 0.000000" quat="0.000000 0.000000 -0.707107 -0.707107">
      <geom name="servo_1_v" mesh="servo" class="visual" material="dark" pos="-0.009752 0.027 -0.0215"/>
      <geom name="servo_1_c" mesh="servo" class="collision" material="dark" pos="-0.009752 0.027 -0.0215" density="1600"/>
    </body>
    <body name="horn_2" pos="0.012750 0.007000 0.010000" quat="0.000000 0.000000 1.000000 0.000000">
      <geom name="horn_2_v" mesh="horn" class="visual" material="horn" pos="-0.01 0.0026 -0.01"/>
      <geom name="horn_2_c" mesh="horn" class="collision" material="horn" pos="-0.01 0.0026 -0.01" density="2700"/>
    </body>
    <!-- 长U bracket: base plate on top bolted under the multi, prongs down. -->
    <body name="longU_down" pos="0.013500 -0.022000 -0.061250" quat="-0.5 -0.5 0.5 0.5">
      <geom name="longU_down_v" mesh="longU" class="visual" material="bracket" pos="-0.027 0.03225 -0.0125"/>
      <geom name="longU_down_c" mesh="longU" class="collision" pos="-0.027 0.03225 -0.0125" density="2700"/>
    </body>
    <!-- M3 screws + nuts through the 长U base-plate holes into the 多功能 bottom (visual only). -->
    <geom name="base_screw_1" type="cylinder" size="0.0016 0.005" pos="0.006600 -0.022100 -0.030500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_screw_2" type="cylinder" size="0.0016 0.005" pos="0.020600 -0.022100 -0.030500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_screw_3" type="cylinder" size="0.0016 0.005" pos="0.013500 -0.029100 -0.030500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_screw_4" type="cylinder" size="0.0016 0.005" pos="0.013500 -0.015100 -0.030500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_nut_1" type="cylinder" size="0.003 0.0012" pos="0.006600 -0.022100 -0.034500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_nut_2" type="cylinder" size="0.003 0.0012" pos="0.020600 -0.022100 -0.034500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_nut_3" type="cylinder" size="0.003 0.0012" pos="0.013500 -0.029100 -0.034500" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="base_nut_4" type="cylinder" size="0.003 0.0012" pos="0.013500 -0.015100 -0.034500" material="dark" contype="0" conaffinity="0" group="2"/>
    <!-- Horn retaining screws (visual only), through the 4 disc holes. -->
  </worldbody>
</mujoco>
