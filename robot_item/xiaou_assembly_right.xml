<?xml version='1.0' encoding='utf-8'?>
<mujoco model="xiaou_assembly_right">
  <!-- RIGHT mirror (Y -> -Y) of xiaou_assembly_left: two perpendicular 短U brackets.
       Chiral meshes mirrored via negative Y scale; Y positions negated, rotations
       conjugated q=(w,x,y,z) -> (w,-x,y,-z). -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom type="mesh" group="3"/></default>
  </default>
  <asset>
    <mesh name="shortU" file="短U/短U支架.STL" scale="0.001 -0.001 0.001"/>
    <material name="bracket" rgba="0.75 0.75 0.78 1"/>
    <material name="dark" rgba="0.18 0.18 0.20 1"/>
  </asset>
  <worldbody>
    <body name="shortU_up" pos="0 0 0.02225" quat="0.7071068 -0.7071068 0 0">
      <geom name="shortU_up_visual" mesh="shortU" class="visual" material="bracket" pos="-0.027 0.02225 -0.0125"/>
      <geom name="shortU_up_collision" mesh="shortU" class="collision" pos="-0.027 0.02225 -0.0125" density="2700"/>
    </body>

    <body name="shortU_down" pos="0 0 -0.02025" quat="0.5 0.5 -0.5 -0.5">
      <geom name="shortU_down_visual" mesh="shortU" class="visual" material="bracket" pos="-0.027 0.02225 -0.0125"/>
      <geom name="shortU_down_collision" mesh="shortU" class="collision" pos="-0.027 0.02225 -0.0125" density="2700"/>
    </body>

    <geom name="screw_1" type="cylinder" size="0.0016 0.004" pos="0.007 0 0.0" quat="0.7071068 -0.7071068 0 0" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="screw_2" type="cylinder" size="0.0016 0.004" pos="-0.007 0 0.0" quat="0.7071068 -0.7071068 0 0" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="screw_3" type="cylinder" size="0.0016 0.004" pos="0 -0.007 0.0" quat="0.7071068 -0.7071068 0 0" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="screw_4" type="cylinder" size="0.0016 0.004" pos="0 0.007 0.0" quat="0.7071068 -0.7071068 0 0" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="nut_1" type="cylinder" size="0.003 0.0012" pos="0.007 0 0.0052" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="nut_2" type="cylinder" size="0.003 0.0012" pos="-0.007 0 0.0052" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="nut_3" type="cylinder" size="0.003 0.0012" pos="0 -0.007 0.0052" material="dark" contype="0" conaffinity="0" group="2"/>
    <geom name="nut_4" type="cylinder" size="0.003 0.0012" pos="0 0.007 0.0052" material="dark" contype="0" conaffinity="0" group="2"/>
  </worldbody>
</mujoco>
