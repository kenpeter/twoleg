<?xml version='1.0' encoding='utf-8'?>
<mujoco model="foot_assembly_right">
  <!-- RIGHT foot: sagittal mirror (Y -> -Y) of foot_assembly_left.xml.
       The parts are chiral, so the meshes are mirrored with a negative Y scale; body/geom
       Y positions are negated and each rotation R is conjugated by the mirror,
       q=(w,x,y,z) -> (w,-x,y,-z).  Left/right therefore share the same STL files. -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom type="mesh" group="3"/></default>
  </default>
  <asset>
    <mesh name="foot" file="大脚板/脚板支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="multi" file="多功能/多功能支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="servo" file="舵机/舵机.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="horn" file="金属舵盘/金属舵盘.STL" scale="0.001 -0.001 0.001"/>
    <material name="bracket" rgba="0.75 0.75 0.78 1"/>
    <material name="dark" rgba="0.18 0.18 0.20 1"/>
    <material name="horn" rgba="0.80 0.80 0.82 1"/>
  </asset>
  <worldbody>
    <body name="foot" pos="0 0 0">
      <geom name="foot_visual" mesh="foot" class="visual" material="bracket" pos="-0.06175 0.03175 -0.001"/>
      <geom name="foot_collision" mesh="foot" class="collision" pos="-0.06175 0.03175 -0.001" density="2700"/>

      <body name="multi" pos="0.022 0 0.0135" quat="0.70710678 0 0 -0.70710678">
        <geom name="multi_visual" mesh="multi" class="visual" material="bracket" pos="-0.029 0.0185 -0.0125"/>
        <geom name="multi_collision" mesh="multi" class="collision" pos="-0.029 0.0185 -0.0125" density="2700"/>
      </body>

      <body name="ankle_servo" pos="0.017 0 0.01275" quat="0 0.7071068 0 -0.7071068">
        <geom name="servo_visual" mesh="servo" class="visual" material="dark" pos="-0.009752 0.027 -0.0215"/>
        <geom name="servo_collision" mesh="servo" class="collision" pos="-0.009752 0.027 -0.0215" density="1600"/>
      </body>

      <body name="horn" pos="-0.007 -0.010 0.01275" quat="0.5 -0.5 0.5 0.5">
        <!-- 金属舵盘 (metal horn disc), mirrored: body/geom Y negated, rotation conjugated. -->
        <geom name="horn_visual" mesh="horn" class="visual" material="horn" pos="-0.010 0.0026 -0.010"/>
      </body>
    </body>
  </worldbody>
</mujoco>
