<?xml version='1.0' encoding='utf-8'?>
<mujoco model="leg_assembly_right">
  <!-- Manual p.11 "左腿" ankle = foot_assembly_left + little_u_assembly_left:
       大脚板 + 多功能支架 + 舵机 + 金属舵盘 with the two perpendicular 短U brackets on top.
       The little_u is shifted so the lower 短U big hole is concentric with the servo shaft /
       horn centre hole (Y = 0.010, Z = 0.01275), so a screw locks them together. -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>
  <default>
    <default class="visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom type="mesh" group="3"/></default>
  </default>
  <asset>
    <mesh name="foot" file="大脚板/脚板支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="multi" file="多功能/多功能支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="shortU" file="短U/短U支架.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="servo" file="舵机/舵机.STL" scale="0.001 -0.001 0.001"/>
    <mesh name="horn" file="金属舵盘/金属舵盘.STL" scale="0.001 -0.001 0.001"/>
    <material name="bracket" rgba="0.75 0.75 0.78 1"/>
    <material name="dark" rgba="0.18 0.18 0.20 1"/>
    <material name="horn" rgba="0.80 0.80 0.82 1"/>
  </asset>
  <worldbody>
    <body name="foot" pos="0.000000 -0.000000 0.000000">
      <geom name="foot_visual" mesh="foot" class="visual" material="bracket" pos="-0.061750 0.031750 -0.001000"/>
      <geom name="foot_collision" mesh="foot" class="collision" pos="-0.061750 0.031750 -0.001000" density="2700"/>

      <body name="multi" pos="0.022000 -0.000000 0.013500" quat="0.707107 -0.000000 0.000000 -0.707107">
        <geom name="multi_visual" mesh="multi" class="visual" material="bracket" pos="-0.029000 0.018500 -0.012500"/>
        <geom name="multi_collision" mesh="multi" class="collision" pos="-0.029000 0.018500 -0.012500" density="2700"/>
      </body>

      <body name="ankle_servo" pos="0.017000 -0.000000 0.012750" quat="0.000000 0.707107 0.000000 -0.707107">
