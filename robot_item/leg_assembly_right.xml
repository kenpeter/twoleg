      <geom name="nut_4" type="cylinder" size="0.003 0.0012" pos="0.024500 -0.010000 0.047950" material="dark" contype="0" conaffinity="0" group="2"/>
    </body>
      <body name="multi_0" pos="0.018250 -0.012000 0.144500" quat="0.000000 -0.707107 0.000000 -0.707107">
