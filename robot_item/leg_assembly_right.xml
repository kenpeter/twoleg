        <geom name="horn_visual" mesh="horn" class="visual" material="horn" pos="-0.010000 0.002600 -0.010000"/>
      </body>

      <!-- little_u_assembly_left, rotated 90 deg about Z and shifted so its lower big hole
           lines up with the servo shaft / horn centre. -->
      <body name="shortU_up" pos="0.017500 -0.010000 0.065000" quat="0.500000 -0.500000 0.500000 -0.500000">
